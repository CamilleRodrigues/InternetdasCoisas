int buttonPin = 2;  
int buttonPin1 = 3;
int ledPin = 13;   
int ledPin1 = 11;
int ledPin2 = 12;

int buttonState = 0; //variável -> está inclinando se é 5 ou 0
int buttonState1 = 0;

void setup() {
  pinMode(ledPin, OUTPUT);
  pinMode(buttonPin, INPUT);
  pinMode(ledPin1, OUTPUT);
  pinMode(buttonPin1, INPUT);
}

void loop() {
  buttonState = digitalRead(buttonPin);
  buttonState1 = digitalRead(buttonPin1);

  if (buttonState == HIGH) { //1 = 5V = HIGH - Ligado
    digitalWrite(ledPin, HIGH);
  } else {
    digitalWrite(ledPin, LOW); //0 = 0V = LOW - Desligado
  }
  
  if (buttonState1 == HIGH) { //1 = 5V = HIGH - Ligado
    digitalWrite(ledPin1, HIGH);
  } else {
    digitalWrite(ledPin1, LOW); //0 = 0V = LOW - Desligado
  }
  
  if (buttonState == HIGH && buttonState1 == HIGH) { //1 = 5V = HIGH - Ligado
    digitalWrite(ledPin2, HIGH);
  } else {
    digitalWrite(ledPin2, LOW); //0 = 0V = LOW - Desligado
  }
}

